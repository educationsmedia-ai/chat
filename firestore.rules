rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitive Definitions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Room Entity Validation Helper (Supports up to 20 participants)
    function isValidRoom(data) {
      return data.keys().hasAll(['code', 'status', 'createdBy']) &&
        data.code is string && data.code.size() >= 4 && data.code.size() <= 10 && data.code.matches('^[A-Z0-9]+$') &&
        data.status is string && (data.status == 'waiting' || data.status == 'active' || data.status == 'closed') &&
        data.createdBy is string && data.createdBy.size() <= 128 &&
        (!('participantCount' in data) || (data.participantCount is int && data.participantCount >= 1 && data.participantCount <= 20)) &&
        (!('participantIds' in data) || (data.participantIds is list && data.participantIds.size() >= 1 && data.participantIds.size() <= 20)) &&
        (!('maxParticipants' in data) || (data.maxParticipants is int && data.maxParticipants <= 20));
    }

    // Message Entity Validation Helper (Supports Text & Compressed Photos)
    function isValidMessage(data) {
      return data.keys().hasAll(['senderId', 'senderName', 'text', 'read']) &&
        data.senderId is string && data.senderId.size() >= 1 && data.senderId.size() <= 128 &&
        data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 64 &&
        data.text is string && data.text.size() <= 2000 &&
        data.read is bool &&
        (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 350000));
    }

    // Rooms Collection
    match /rooms/{roomId} {
      // Allow get to check room exists and see details
      allow get: if isValidId(roomId);
      
      // Allow list of room by document id
      allow list: if isValidId(roomId);

      // Create: user creates room with valid structure
      allow create: if isValidId(roomId) &&
        isValidRoom(incoming()) &&
        (incoming().status == 'waiting' || incoming().status == 'active');

      // Updates partitioned by actions
      allow update: if isValidId(roomId) && (
        // Action 1: New participant joins or re-joins (strictly enforces maximum 20 members limit)
        (
          incoming().status in ['waiting', 'active', 'closed'] &&
          (!('participantCount' in incoming()) || (incoming().participantCount is int && incoming().participantCount <= 20)) &&
          (!('participantIds' in incoming()) || (incoming().participantIds is list && incoming().participantIds.size() <= 20)) &&
          (!('maxParticipants' in incoming()) || (incoming().maxParticipants is int && incoming().maxParticipants <= 20))
        ) ||
        // Action 2: Legacy 2-user support
        (
          existing().status == 'waiting' &&
          existing().user2 == null &&
          incoming().user2 != null &&
          incoming().status == 'active'
        )
      );

      // Subcollection: Messages
      match /messages/{messageId} {
        allow get, list: if isValidId(roomId);

        allow create: if isValidId(roomId) &&
          isValidId(messageId) &&
          isValidMessage(incoming());

        // Counterpart marks message as read
        allow update: if isValidId(roomId) &&
          isValidId(messageId) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['read']) &&
          incoming().read == true;

        allow delete: if false;
      }

      // Subcollection: WebRTC Video Call Signaling
      match /calls/{callId} {
        allow get, list: if isValidId(roomId);

        allow create: if isValidId(roomId) &&
          isValidId(callId) &&
          incoming().keys().hasAll(['callerId', 'callerName', 'receiverId', 'status', 'offer']) &&
          incoming().status == 'ringing';

        allow update: if isValidId(roomId) &&
          isValidId(callId) &&
          (
            // Receiver accepts with answer SDP
            (incoming().status == 'accepted' && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'answer'])) ||
            // Either party rejects or ends call
            ((incoming().status == 'rejected' || incoming().status == 'ended' || incoming().status == 'busy') &&
             incoming().diff(existing()).affectedKeys().hasOnly(['status']))
          );

        allow delete: if isValidId(roomId) && isValidId(callId);

        match /callerCandidates/{candId} {
          allow read: if isValidId(roomId) && isValidId(callId);
          allow create: if isValidId(roomId) && isValidId(callId) && isValidId(candId);
        }

        match /receiverCandidates/{candId} {
          allow read: if isValidId(roomId) && isValidId(callId);
          allow create: if isValidId(roomId) && isValidId(callId) && isValidId(candId);
        }
      }
    }

    // Health check document for connection testing
    match /test/{docId} {
      allow read: if isValidId(docId);
      allow write: if false;
    }
  }
}
