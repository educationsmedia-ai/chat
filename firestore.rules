rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitive Definitions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Room Entity Validation Helper
    function isValidRoom(data) {
      return data.keys().hasAll(['code', 'status', 'createdBy', 'user1', 'user1Online']) &&
        data.code is string && data.code.size() >= 4 && data.code.size() <= 10 && data.code.matches('^[A-Z0-9]+$') &&
        data.status is string && (data.status == 'waiting' || data.status == 'active' || data.status == 'closed') &&
        data.createdBy is string && data.createdBy.size() <= 128 &&
        data.user1 is map && data.user1.uid is string && data.user1.uid == data.createdBy &&
        data.user1Online is bool;
    }

    // Message Entity Validation Helper
    function isValidMessage(data) {
      return data.keys().hasAll(['senderId', 'senderName', 'text', 'read']) &&
        data.senderId is string && data.senderId.size() <= 128 && data.senderId == request.auth.uid &&
        data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 64 &&
        data.text is string && data.text.size() >= 1 && data.text.size() <= 2000 &&
        data.read is bool;
    }

    // Helper to check if caller is participant in room
    function isRoomParticipant(roomData) {
      return isSignedIn() && (
        (roomData.user1 != null && roomData.user1.uid == request.auth.uid) ||
        (roomData.user2 != null && roomData.user2.uid == request.auth.uid)
      );
    }

    // Rooms Collection
    match /rooms/{roomId} {
      // Allow get to check room exists and see details if signed in
      allow get: if isSignedIn() && isValidId(roomId);
      
      // Allow list of rooms only if user is participant (no blanket listing)
      allow list: if isSignedIn() && (
        resource.data.user1.uid == request.auth.uid ||
        (resource.data.user2 != null && resource.data.user2.uid == request.auth.uid)
      );

      // Create: Authenticated user creates room with valid structure
      allow create: if isSignedIn() &&
        isValidId(roomId) &&
        isValidRoom(incoming()) &&
        incoming().createdBy == request.auth.uid &&
        incoming().status == 'waiting';

      // Updates partitioned by actions
      allow update: if isSignedIn() && isValidId(roomId) && (
        // Action 1: User 2 joins a waiting room
        (
          existing().status == 'waiting' &&
          existing().user2 == null &&
          incoming().user2 != null &&
          incoming().user2.uid == request.auth.uid &&
          incoming().user1.uid != request.auth.uid &&
          incoming().status == 'active' &&
          incoming().diff(existing()).affectedKeys().hasOnly(['user2', 'status', 'user2Online', 'user2Typing'])
        ) ||
        // Action 2: User 1 updates presence or typing
        (
          existing().user1.uid == request.auth.uid &&
          incoming().diff(existing()).affectedKeys().hasOnly(['user1Online', 'user1Typing'])
        ) ||
        // Action 3: User 2 updates presence or typing
        (
          existing().user2 != null &&
          existing().user2.uid == request.auth.uid &&
          incoming().diff(existing()).affectedKeys().hasOnly(['user2Online', 'user2Typing'])
        ) ||
        // Action 4: Close room by either participant
        (
          isRoomParticipant(existing()) &&
          incoming().status == 'closed' &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status'])
        )
      );

      // Subcollection: Messages
      match /messages/{messageId} {
        allow get: if isSignedIn() &&
          isValidId(messageId) &&
          isRoomParticipant(get(/databases/$(database)/documents/rooms/$(roomId)).data);

        allow list: if isSignedIn() &&
          isRoomParticipant(get(/databases/$(database)/documents/rooms/$(roomId)).data);

        allow create: if isSignedIn() &&
          isValidId(messageId) &&
          isRoomParticipant(get(/databases/$(database)/documents/rooms/$(roomId)).data) &&
          isValidMessage(incoming());

        // Counterpart marks message as read
        allow update: if isSignedIn() &&
          isValidId(messageId) &&
          isRoomParticipant(get(/databases/$(database)/documents/rooms/$(roomId)).data) &&
          existing().senderId != request.auth.uid &&
          incoming().diff(existing()).affectedKeys().hasOnly(['read']) &&
          incoming().read == true;

        allow delete: if false;
      }
    }

    // Health check document for connection testing
    match /test/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
  }
}
