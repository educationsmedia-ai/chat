{
  "entities": {
    "Room": {
      "title": "Room",
      "description": "Multiplayer real-time chat room supporting up to 20 participants",
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "description": "Unique room code used to join",
          "pattern": "^[A-Z0-9]{4,10}$",
          "maxLength": 10,
          "minLength": 4
        },
        "name": {
          "type": "string",
          "description": "Descriptive room name",
          "maxLength": 64
        },
        "status": {
          "type": "string",
          "description": "Status of the room",
          "enum": ["waiting", "active", "closed"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "createdBy": {
          "type": "string",
          "description": "User ID of creator",
          "maxLength": 128
        },
        "maxParticipants": {
          "type": "integer",
          "description": "Maximum allowed participants in room (20)",
          "maximum": 20,
          "minimum": 2
        },
        "participantCount": {
          "type": "integer",
          "description": "Current number of joined participants",
          "maximum": 20,
          "minimum": 1
        },
        "participantIds": {
          "type": "array",
          "description": "List of user IDs of participants currently in the room",
          "items": { "type": "string" }
        },
        "participants": {
          "type": "object",
          "description": "Map of participant details keyed by user ID"
        }
      },
      "required": ["code", "status", "createdBy", "maxParticipants", "participantCount", "participantIds", "participants"]
    },
    "Message": {
      "title": "Message",
      "description": "Chat message sent in a room with optional photo",
      "type": "object",
      "properties": {
        "senderId": {
          "type": "string",
          "description": "User ID of the message sender",
          "maxLength": 128
        },
        "senderName": {
          "type": "string",
          "description": "Display name of the sender",
          "maxLength": 64,
          "minLength": 1
        },
        "text": {
          "type": "string",
          "description": "Body of the chat message or image caption",
          "maxLength": 2000
        },
        "imageUrl": {
          "type": "string",
          "description": "Optional compressed base64 image data URL",
          "maxLength": 350000
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the message was sent"
        },
        "read": {
          "type": "boolean",
          "description": "Whether the message has been read by the other participant"
        }
      },
      "required": ["senderId", "senderName", "read"]
    },
    "Call": {
      "title": "Call",
      "description": "WebRTC Video Call signaling session between room participants",
      "type": "object",
      "properties": {
        "callerId": { "type": "string" },
        "callerName": { "type": "string" },
        "receiverId": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["ringing", "accepted", "rejected", "ended", "busy"]
        },
        "offer": { "type": "object" },
        "answer": { "type": "object" }
      },
      "required": ["callerId", "callerName", "receiverId", "status"]
    }
  },
  "firestore": {
    "/rooms/{roomId}": {
      "schema": "Room",
      "description": "Two-person multiplayer chat room document"
    },
    "/rooms/{roomId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Subcollection of real-time messages for the room"
    },
    "/rooms/{roomId}/calls/{callId}": {
      "schema": "Call",
      "description": "Subcollection of WebRTC call sessions"
    }
  }
}
