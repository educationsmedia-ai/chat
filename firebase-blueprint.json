{
  "entities": {
    "Room": {
      "title": "Room",
      "description": "Two-person multiplayer real-time chat room",
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "description": "Unique room code used to join",
          "pattern": "^[A-Z0-9]{4,10}$",
          "maxLength": 10,
          "minLength": 4
        },
        "name": {
          "type": "string",
          "description": "Descriptive room name",
          "maxLength": 64
        },
        "status": {
          "type": "string",
          "description": "Status of the room",
          "enum": ["waiting", "active", "closed"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "createdBy": {
          "type": "string",
          "description": "User ID of creator",
          "maxLength": 128
        },
        "user1": {
          "type": "object",
          "description": "Information about the first participant"
        },
        "user2": {
          "type": "object",
          "description": "Information about the second participant or null if waiting"
        },
        "user1Online": {
          "type": "boolean",
          "description": "Presence flag for user 1"
        },
        "user2Online": {
          "type": "boolean",
          "description": "Presence flag for user 2"
        },
        "user1Typing": {
          "type": "boolean",
          "description": "Typing indicator for user 1"
        },
        "user2Typing": {
          "type": "boolean",
          "description": "Typing indicator for user 2"
        }
      },
      "required": ["code", "status", "createdBy", "user1", "user1Online"]
    },
    "Message": {
      "title": "Message",
      "description": "Chat message sent in a room",
      "type": "object",
      "properties": {
        "senderId": {
          "type": "string",
          "description": "User ID of the message sender",
          "maxLength": 128
        },
        "senderName": {
          "type": "string",
          "description": "Display name of the sender",
          "maxLength": 64,
          "minLength": 1
        },
        "text": {
          "type": "string",
          "description": "Body of the chat message",
          "maxLength": 2000,
          "minLength": 1
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the message was sent"
        },
        "read": {
          "type": "boolean",
          "description": "Whether the message has been read by the other participant"
        }
      },
      "required": ["senderId", "senderName", "text", "read"]
    }
  },
  "firestore": {
    "/rooms/{roomId}": {
      "schema": "Room",
      "description": "Two-person multiplayer chat room document"
    },
    "/rooms/{roomId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Subcollection of real-time messages for the room"
    }
  }
}
